# Add to the kcdev2 nginx site config on the FRONT box (10.128.0.14 — kc-wiki
# wfc-gcp-network), same server{} block as /crete/ and /homeservices/.
# VERIFY 8165 IS STILL FREE FIRST — the kc-wiki port table has drifted before:
#   grep -rn "8165\|/horry/" /etc/nginx/sites-enabled/     (front box)
#   ss -ltnp | grep 8165                                   (kc-dev-2)
# Reload with: sudo nginx -t && sudo systemctl reload nginx

# Trailing slash on proxy_pass strips the /horry/ prefix — the app serves at its own
# root; pages use relative API paths (kc-wiki kcdev2-topology).
location /horry/ {
    client_max_body_size 5m;
    proxy_pass http://10.128.0.20:8165/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_buffering off;
}
